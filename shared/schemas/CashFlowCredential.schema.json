{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CashFlowCredential",
  "title": "CashFlowCredential",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysisPeriodMonths", "incomeBandMin", "incomeBandMax", "activeIncomeMonths", "incomeConsistency", "existingMonthlyObligations", "highRiskIndicators", "averageMonthlyInflows"],
  "properties": {
    "analysisPeriodMonths": { "type": "integer", "minimum": 1 },
    "incomeBandMin": { "type": "number", "minimum": 0 },
    "incomeBandMax": { "type": "number", "minimum": 0 },
    "activeIncomeMonths": { "type": "integer", "minimum": 0 },
    "incomeConsistency": { "type": "number", "minimum": 0, "maximum": 1 },
    "existingMonthlyObligations": { "type": "number", "minimum": 0 },
    "highRiskIndicators": { "type": "array", "items": { "type": "string" } },
    "averageMonthlyInflows": { "type": "number", "minimum": 0 }
  }
}
