{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GigIncomeCredential",
  "title": "GigIncomeCredential",
  "type": "object",
  "additionalProperties": false,
  "required": ["incomeThreshold", "currency", "qualifies", "consecutiveMonths", "employerName", "platformName"],
  "properties": {
    "incomeThreshold": { "type": "number", "minimum": 0 },
    "currency": { "type": "string" },
    "qualifies": { "type": "boolean" },
    "consecutiveMonths": { "type": "integer", "minimum": 0 },
    "employerName": { "type": "string" },
    "platformName": { "type": "string" }
  }
}
